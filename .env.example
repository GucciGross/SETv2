# SET — copy to .env and adjust

# Web UI port
SET_PORT=8080

# --- Optional HTTPS for the web UI (SET_TLS=1) ---
# Browsers only allow microphone/speech access (voice input) on secure origins
# — phones hitting SET over plain http://LAN-IP get no mic. SET_TLS=1 enables
# https on port 8443 with a self-signed cert (accept the warning once), or mount
# your own certs: put set.crt + set.key in ./web/certs and point SET_TLS_CERT_DIR
# at that directory in docker-compose.
# SET_TLS=1
# SET_TLS_PORT=8443

# Postgres (compose-internal)
POSTGRES_PASSWORD=set

# Auth secret — MUST change in production
JWT_SECRET=change-me-in-production

# Seed demo workspace on first boot (demo@set.local / demo-demo)
SEED_DEMO=0

# Set to 0 on hosted deployments to close public registration (operators invite instead)
# REGISTRATION_OPEN=1

# --- Optional bootstrap LLM provider (BYOK) ---
# Any OpenAI-compatible endpoint. Leave unset to configure in the web UI instead.
# Ollama on the host machine (from inside containers use host.docker.internal):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_CHAT_MODEL=llama3.1
# LLM_EMBED_MODEL=nomic-embed-text
# LLM_API_KEY=

# --- Optional Library surface (HuggingFace Hub imports) ---
# Raises rate limits / unlocks gated datasets:
# HF_TOKEN=hf_xxxx

# --- Optional RAGFlow integration (deep document understanding retrieval) ---
# When set, notebooks bound to a RAGFlow dataset route retrieval through it:
# RAGFLOW_URL=http://ragflow:9380
# RAGFLOW_API_KEY=ragflow-xxxx

# --- Optional voice input (speech-to-text) ---
# Any OpenAI-compatible /audio/transcriptions endpoint (Groq Whisper, OpenAI,
# whisper.cpp server…). Falls back to LLM_BASE_URL when only that is set;
# without either, the web client falls back to the browser's Web Speech API.
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-large-v3

# --- Optional Slack channel (CopilotKit Intelligence) ---
# 1. Create a Slack Channel at https://dashboard.operations.copilotkit.ai
#    (note its Code) and a project API key in the same project.
# 2. docker compose --profile channels up -d
# 3. Link the Slack workspace to a SET space in Settings → Channels.
# CHANNEL_CODE=my-set-slack
# INTELLIGENCE_API_KEY=ck_live_...
# Self-hosted Intelligence (optional; pass both):
# INTELLIGENCE_API_URL=https://intelligence.example.com
# INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.example.com
# Fallback SET space for unlinked Slack workspaces (uuid):
# CHANNEL_SPACE_ID=

# --- SET anonymous usage telemetry ---
# Aggregated feature counters only (agent runs, pages created, transcriptions…)
# plus coarse instance shape (version, #providers). No content, no PII, no IPs.
# One random instance id per deployment. Opt out entirely:
# TELEMETRY_ENABLED=0
# Point at your own receiver (e.g. for self-hosted fleets) instead of ours:
# TELEMETRY_URL=https://telemetry.example.com/v1/ingest

# --- Local development (no Docker) ---
# server: DATABASE_URL=postgres://set:set@localhost:5432/set npm run dev
# web:    npm run dev  (proxies /api to localhost:4000)

# --- Email (password resets + invites; without it, links log to the console) ---
# Primary: ForwardEmail REST API (https://forwardemail.net). The domain must be
# verified in your ForwardEmail account and the "from" address must be an alias on it.
# FORWARDEMAIL_API_KEY=fda_...
# FORWARDEMAIL_DOMAIN=trainwithset.com
# FORWARDEMAIL_FROM=noreply@trainwithset.com
# APP_URL=https://set.example.com
# Fallback: plain SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SET <noreply@example.com>

# ---- LLM gateway (optional; PLAN.md Phase 5) --------------------------------
# Metered, capped model access ("SET Cloud" provider). Start it with:
#   docker compose -f docker-compose.yml -f docker-compose.cloud.yml --profile cloud up -d
# The gateway forwards to one OpenAI-compatible upstream — the same LLM_* vars
# the server uses by default, or explicit ones:
# GATEWAY_UPSTREAM_URL=https://api.example.com/v1
# GATEWAY_UPSTREAM_KEY=sk-...
# USD per 1M prompt/completion tokens, matched by model-substring; enables
# USD spend caps. Without prices, metering is token-only.
# GATEWAY_PRICES={"glm-4.7":[0.6,2.2]}
# GATEWAY_RATE_LIMIT_PER_MIN=120
