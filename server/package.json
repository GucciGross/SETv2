{
  "name": "set-server",
  "version": "2.1.0",
  "description": "SET — Strategic Enablement Toolkit: open-source knowledge + learning OS (backend)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@copilotkit/runtime": "^1.69.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/nodemailer": "^8.0.1",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.26.2",
    "hyparquet": "^1.29.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "marked": "^12.0.2",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.5",
    "rxjs": "^7.8.1",
    "turndown": "^7.1.3",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
